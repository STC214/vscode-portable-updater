# Review snapshots and verification workspaces
/.update-review/

# Legacy local cache names; current scripts use ignored /dist/.build/.
/.tmp/
/.gocache/

# Generated binaries, download cache, and machine-specific runtime config
/dist/
/portable_vscode_updater_data/

# Interrupted downloads and editor temporary files
*.download
*.swp
*.swo
*~

# Test / coverage outputs
*.test
*.test.exe
/coverage/
/coverage.out
/coverage.html

# Operating system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Keep Go source/tests, go.mod/go.sum, build.ps1, and icon resources tracked.
# Existing tracked files are not removed by ignore rules.
